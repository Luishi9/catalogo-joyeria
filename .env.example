# Variables publicas inyectadas por Vite en el frontend.
# Copia este archivo a ".env" y rellena con tus valores reales.
# Importante: NUNCA pongas aqui la clave `sb_secret_*` ni ninguna service_role key,
# porque este .env se procesa en el navegador y seria visible para cualquier usuario.

# URL del proyecto Supabase (sin barra final)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publica (publishable / anon). Empieza por sb_publishable_...
VITE_SUPABASE_ANON_KEY=sb_publishable_REEMPLAZA_CON_TU_ANON_KEY

# Nombre del bucket publico de Storage para imagenes
VITE_SUPABASE_BUCKET=imagenes-joyeria

# --- Solo para scripts Node locales (migracion de datos, etc.) ---
# NO usar estas variables en el codigo del frontend. Se usaran solo en scripts CLI
# que se ejecutan con `node` desde tu PC, nunca en el bundle del navegador.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REEMPLAZA_SOLO_PARA_SCRIPTS_LOCALES
